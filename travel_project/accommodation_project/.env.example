# Firebase client config
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_DATABASE_URL=YOUR_DATABASE_URL
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID
FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Firebase admin service account
FIREBASE_ADMIN_TYPE=service_account
FIREBASE_ADMIN_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_ADMIN_PRIVATE_KEY_ID=YOUR_PRIVATE_KEY_ID
FIREBASE_ADMIN_PRIVATE_KEY="PASTE_PRIVATE_KEY_WITH_ESCAPED_NEWLINES"
FIREBASE_ADMIN_CLIENT_EMAIL=YOUR_FIREBASE_ADMIN_CLIENT_EMAIL
FIREBASE_ADMIN_CLIENT_ID=YOUR_CLIENT_ID
FIREBASE_ADMIN_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_ADMIN_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_ADMIN_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_ADMIN_CLIENT_X509_CERT_URL=YOUR_FIREBASE_ADMIN_CLIENT_X509_CERT_URL
FIREBASE_ADMIN_UNIVERSE_DOMAIN=googleapis.com

# Google login
GOOGLE_URL=http://127.0.0.1:8000/auth/google/start
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_API_KEY
FRONTEND_URL=http://127.0.0.1:8000
COOKIE_SECURE=false

# Chat parser
# Keep deterministic parser by default. Set CHAT_API_ENABLE_HF_AGENT=1 only
# when the machine has enough RAM/VRAM for local HF text models.
CHAT_API_ENABLE_HF_AGENT=0
CHAT_API_LLM_STRATEGY=auto
CHAT_API_MODEL=Qwen/Qwen2.5-1.5B-Instruct
CHAT_API_LIGHT_MODEL=Qwen/Qwen2.5-0.5B-Instruct
CHAT_API_FALLBACK_MODEL=
CHAT_API_STRONG_MODEL=
CHAT_API_DEVICE=auto
CHAT_API_MAX_NEW_TOKENS=256
CHAT_API_TEMPERATURE=0.1
CHAT_API_TOP_P=0.9
CHAT_API_DO_SAMPLE=false
CHAT_API_TIMEOUT_SECONDS=25
CHAT_API_PROMPT_EXAMPLE_COUNT=5
CHAT_API_USE_NER=0
CHAT_API_NER_MODEL=
CHAT_API_INCLUDE_DIAGNOSTICS=0
CHAT_API_STRICT_SUPPORTED_AREAS=1

# Geocoder for near-landmark chat recommendations
GEOCODER_PROVIDER=osm
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODER_USER_AGENT=TravelProjectAccommodation/1.0
GEOCODER_TIMEOUT_SECONDS=8
GEOCODER_CACHE_ENABLED=true
OVERPASS_API_URLS=https://z.overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter,https://overpass.osm.ch/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter,https://overpass-api.de/api/interpreter

# Voice recognition
# STT_BACKEND=local uses local transformers/PhoWhisper. STT_BACKEND=hf_api uses
# Hugging Face Inference API with HF_TOKEN and HF_API_MODEL.
STT_BACKEND=local
VOICE_WEAK_MODEL=vinai/PhoWhisper-base
VOICE_BALANCED_MODEL=vinai/PhoWhisper-medium
VOICE_STRONG_MODEL=vinai/PhoWhisper-large
HF_TOKEN=
HF_API_MODEL=openai/whisper-large-v3
VOICE_MAX_AUDIO_MB=5
VOICE_MIN_AUDIO_SECONDS=1
VOICE_MAX_AUDIO_SECONDS=30
# Backward-compatible aliases are still supported. Keep them commented unless
# you intentionally need old config names; active legacy values override defaults.
# VOICE_ASR_WEAK_MODEL=vinai/PhoWhisper-base
# VOICE_ASR_BALANCED_MODEL=vinai/PhoWhisper-medium
# VOICE_ASR_STRONG_MODEL=vinai/PhoWhisper-large
# VOICE_ASR_PROFILE=balanced
# VOICE_ASR_MODEL=vinai/PhoWhisper-medium
VOICE_ASR_FALLBACK_MODEL=vinai/PhoWhisper-base
VOICE_ASR_LANGUAGE=vi
VOICE_ASR_TASK=transcribe
VOICE_DEVICE=auto
VOICE_MAX_NEW_TOKENS=96
VOICE_NUM_BEAMS=1
# Frontend records short clips, so chunking is off by default for lower latency.
VOICE_CHUNK_LENGTH_S=0
VOICE_ASR_BATCH_SIZE=1
