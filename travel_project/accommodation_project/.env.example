# Firebase client config
FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
FIREBASE_DATABASE_URL=YOUR_DATABASE_URL
FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_STORAGE_BUCKET=YOUR_STORAGE_BUCKET
FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
FIREBASE_APP_ID=YOUR_APP_ID
FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Firebase admin service account
FIREBASE_ADMIN_TYPE=service_account
FIREBASE_ADMIN_PROJECT_ID=YOUR_PROJECT_ID
FIREBASE_ADMIN_PRIVATE_KEY_ID=YOUR_PRIVATE_KEY_ID
FIREBASE_ADMIN_PRIVATE_KEY="PASTE_PRIVATE_KEY_WITH_ESCAPED_NEWLINES"
FIREBASE_ADMIN_CLIENT_EMAIL=YOUR_FIREBASE_ADMIN_CLIENT_EMAIL
FIREBASE_ADMIN_CLIENT_ID=YOUR_CLIENT_ID
FIREBASE_ADMIN_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_ADMIN_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_ADMIN_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_ADMIN_CLIENT_X509_CERT_URL=YOUR_FIREBASE_ADMIN_CLIENT_X509_CERT_URL
FIREBASE_ADMIN_UNIVERSE_DOMAIN=googleapis.com

# Google login
GOOGLE_URL=http://127.0.0.1:8000/auth/google/start
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback
FIREBASE_WEB_API_KEY=YOUR_FIREBASE_API_KEY
FRONTEND_URL=http://127.0.0.1:8000
COOKIE_SECURE=false
